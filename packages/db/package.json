{
  "name": "@safe-her/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down",
    "db:import": "bun run scripts/import-historical.ts",
    "db:seed-incidents": "bun run scripts/seed-incidents.ts",
    "db:fetch": "bun run src/fetch-crime-data.ts",

    "db:fetch-news": "bun run src/fetch-gdelt.ts",
    "db:fetch-news-gkg": "bun run src/fetch-gdelt-gkg.ts",
    "db:fetch-news-incremental": "GKG_MODE=incremental bun run src/fetch-gdelt-gkg.ts",
    "db:backfill-news": "GKG_MODE=backfill GKG_BACKFILL_DAYS=180 bun run src/fetch-gdelt-gkg.ts",
    "db:backfill-news-year": "GKG_MODE=backfill GKG_BACKFILL_DAYS=365 bun run src/fetch-gdelt-gkg.ts",
    "db:cleanup-news": "bun run src/cleanup-news.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@safe-her/env": "workspace:*",
    "dotenv": "catalog:",
    "ngeohash": "^0.6.4",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@safe-her/config": "workspace:*",
    "@types/ngeohash": "^0.6.8",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "typescript": "catalog:"
  }
}
