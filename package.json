{
  "name": "safe-sphere-ai",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "better-auth": "1.6.25",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @safe-sphere-ai/db",
    "db:studio": "turbo run db:studio -F @safe-sphere-ai/db",
    "db:generate": "turbo run db:generate -F @safe-sphere-ai/db",
    "db:migrate": "turbo run db:migrate -F @safe-sphere-ai/db",
    "db:start": "turbo run db:start -F @safe-sphere-ai/db",
    "db:watch": "turbo run db:watch -F @safe-sphere-ai/db",
    "db:stop": "turbo run db:stop -F @safe-sphere-ai/db",
    "db:down": "turbo run db:down -F @safe-sphere-ai/db"
  },
  "dependencies": {
    "@safe-sphere-ai/env": "workspace:*",
    "dotenv": "catalog:",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "ngeohash": "^0.6.4",
    "react-leaflet": "^5.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@safe-sphere-ai/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/ngeohash": "^0.6.8",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.7"
}
