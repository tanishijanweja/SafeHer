BETTER_AUTH_SECRET=generate-a-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/safe-her

# Optional — AI / data import scripts
GEMINI_API_KEY=
DATA_GOV_API_KEY=

# Optional — real SMS delivery for SOS alerts (if blank and outside
# production, alerts are mock-logged; in production delivery fails loudly)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Optional — where uploaded SOS audio/video clips are stored (defaults to ./uploads)
SOS_UPLOAD_DIR=

# Media links shared with trusted contacts are HMAC-signed and short-lived.
# Set a long random value; defaults to a derivation of BETTER_AUTH_SECRET.
SOS_MEDIA_SECRET=generate-another-random-string

# How long a signed media link stays valid, in seconds (default 7 days
# = 604800). Evidence is never public or permacached.
SOS_MEDIA_TTL_SECONDS=

# How long SOS events + their evidence (live location history, audio clips)
# are retained before being hard-deleted, in days (default 30).
SOS_RETENTION_DAYS=30
